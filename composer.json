{
    "name": "highvertical/widget-package",
    "description": "A Blade-first widget package for Laravel 10, 11, 12, and 13 applications.",
    "type": "package",
    "license": "MIT",
    "keywords": [
        "blade",
        "laravel",
        "laravel-package",
        "widget"
    ],
    "homepage": "https://github.com/highvertical/widget-package",
    "authors": [
        {
            "name": "Highvertical",
            "email": "highverticaltechnologies@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Highvertical\\WidgetPackage\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Highvertical\\WidgetPackage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "support": {
        "issues": "https://github.com/highvertical/widget-package/issues",
        "source": "https://github.com/highvertical/widget-package"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Highvertical\\WidgetPackage\\Providers\\WidgetServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
